{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cure-lite.local/schema/gcr-pacre-v24-protocol-v1.json",
  "title": "CURE-Lite v24 GCR-PACRE evidence preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "status",
    "candidate",
    "control",
    "data_policy",
    "frozen_D_R_sources",
    "OOF4",
    "paired_bounded400",
    "Formal800",
    "relative_performance",
    "safety",
    "authorization",
    "preregistration_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "cure-lite-v24-gcr-pacre-evidence-preregistration-v1"
    },
    "protocol_id": {
      "const": "irstd1k-gcr-pacre-v24-evidence-v1"
    },
    "status": {
      "const": "FROZEN_DESIGN_EXECUTION_NOT_AUTHORIZED"
    },
    "candidate": {
      "const": "GCR-PACRE-v24"
    },
    "control": {
      "const": "PACRE-VC-v23-separately-trained"
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D_R",
        "D_V_payload_access_authorized",
        "D_V_attempt_limit_after_all_prerequisites",
        "D_V_role",
        "D_T_payload_access_authorized",
        "D_T_role",
        "forbidden_before_authorization"
      ],
      "properties": {
        "D_R": {
          "const": "protocol_stages_only_after_stage_specific_authorization"
        },
        "D_V_payload_access_authorized": {
          "const": false
        },
        "D_V_attempt_limit_after_all_prerequisites": {
          "const": 1
        },
        "D_V_role": {
          "const": "adaptive_development_evidence"
        },
        "D_T_payload_access_authorized": {
          "const": false
        },
        "D_T_role": {
          "const": "future_one_shot_confirmation_only"
        },
        "forbidden_before_authorization": {
          "const": [
            "image",
            "mask",
            "feature_tensor",
            "probability_tensor",
            "state_cache_tensor",
            "derived_prediction"
          ]
        }
      }
    },
    "frozen_D_R_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "state_index",
        "root_source_policy"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/sourceBinding"
        },
        "state_index": {
          "$ref": "#/$defs/sourceBinding"
        },
        "root_source_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "grouping_fields",
            "all_derived_records_must_carry_root_source_id",
            "multiple_roots_per_derived_record",
            "missing_root",
            "cross_fold_parent_edge"
          ],
          "properties": {
            "algorithm": {
              "const": "transitive_connected_components_over_same-field_grouping_keys_v1"
            },
            "grouping_fields": {
              "const": [
                "group_id",
                "scene_id",
                "sequence_id",
                "crop_source_id",
                "near_duplicate_group"
              ]
            },
            "all_derived_records_must_carry_root_source_id": {
              "const": true
            },
            "multiple_roots_per_derived_record": {
              "const": "fail_closed"
            },
            "missing_root": {
              "const": "fail_closed"
            },
            "cross_fold_parent_edge": {
              "const": "fail_closed"
            }
          }
        }
      }
    },
    "OOF4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fold_count",
        "seed",
        "namespace",
        "assignment",
        "balance_contract",
        "training_budget_per_trainable_arm_per_fold",
        "arms",
        "BaseA",
        "BaseB_train_fold_selected",
        "cache_isolation",
        "held_out_evidence",
        "pooled_gate"
      ],
      "properties": {
        "fold_count": {
          "const": 4
        },
        "seed": {
          "const": 42
        },
        "namespace": {
          "const": "cure-lite-v24-gcr-pacre-root-oof4-v1"
        },
        "assignment": {
          "const": "sha256_ranked_root_source_round_robin_no_python_hash_v1"
        },
        "balance_contract": {
          "const": "root_counts_differ_by_at_most_one"
        },
        "training_budget_per_trainable_arm_per_fold": {
          "$ref": "#/$defs/boundedBudget"
        },
        "arms": {
          "const": [
            "BaseA",
            "BaseB_train_fold_selected",
            "PACRE_VC_v23_control",
            "GCR_PACRE_v24",
            "GCR_PACRE_v24_forced_G1"
          ]
        },
        "BaseA": {
          "const": {
            "threshold": 0.72,
            "trained": false
          }
        },
        "BaseB_train_fold_selected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threshold_grid_source_repo_path",
            "threshold_grid_source_file_sha256",
            "threshold_grid",
            "selection_population",
            "holdout_label_in_selection",
            "D_V_threshold_0_14_reuse_forbidden",
            "selection_key"
          ],
          "properties": {
            "threshold_grid_source_repo_path": {
              "const": "protocols/IRSTD-1K/stage_a_seed42_fx_v3/stage_a_config.json"
            },
            "threshold_grid_source_file_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "threshold_grid": {
              "const": "0.00_to_1.00_inclusive_step_0.02"
            },
            "selection_population": {
              "const": "train_roots_only"
            },
            "holdout_label_in_selection": {
              "const": false
            },
            "D_V_threshold_0_14_reuse_forbidden": {
              "const": true
            },
            "selection_key": {
              "const": [
                "maximize_pd",
                "maximize_retention",
                "minimize_pixel_fa",
                "minimize_raw_background_fa",
                "minimize_fp_components_per_mp",
                "maximize_threshold"
              ]
            }
          }
        },
        "cache_isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "train_root_allowlist_exact",
            "holdout_opened_only_after_training_terminal_sealed",
            "separate_candidate_control_and_base_eval_storage",
            "symlink_hardlink_reflink_shared_tensor_mmap_process_cache_forbidden",
            "required_storage_identity"
          ],
          "properties": {
            "train_root_allowlist_exact": {
              "const": true
            },
            "holdout_opened_only_after_training_terminal_sealed": {
              "const": true
            },
            "separate_candidate_control_and_base_eval_storage": {
              "const": true
            },
            "symlink_hardlink_reflink_shared_tensor_mmap_process_cache_forbidden": {
              "const": true
            },
            "required_storage_identity": {
              "const": [
                "realpath",
                "device",
                "inode",
                "file_sha256",
                "root_source_ids",
                "creation_phase",
                "reader_allowlist"
              ]
            }
          }
        },
        "held_out_evidence": {
          "type": "object",
          "required": [
            "prediction_population",
            "synthetic_clean_null_target_context_roles_in_metrics",
            "aggregation",
            "fold_metric_arithmetic_mean_is_primary",
            "each_root_held_out_exactly_once",
            "required_sufficient_statistics"
          ],
          "additionalProperties": false,
          "properties": {
            "prediction_population": {
              "const": "factual_only"
            },
            "synthetic_clean_null_target_context_roles_in_metrics": {
              "const": false
            },
            "aggregation": {
              "const": "additive_sufficient_statistics_reconstructing_one_pooled_Formal_equivalent_evaluation"
            },
            "fold_metric_arithmetic_mean_is_primary": {
              "const": false
            },
            "each_root_held_out_exactly_once": {
              "const": true
            },
            "required_sufficient_statistics": {
              "type": "array",
              "minItems": 17,
              "maxItems": 17,
              "uniqueItems": true
            }
          }
        },
        "pooled_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Base_rows_must_be_valid",
            "candidate_true_targets",
            "candidate_recovered_anchor_misses",
            "candidate_mIoU",
            "candidate_nIoU",
            "versus_v23_true_targets",
            "versus_v23_recovered_anchor_misses",
            "versus_v23_mIoU",
            "versus_v23_nIoU",
            "versus_forced_G1_primary_vector",
            "forced_G1_same_terminal_weights",
            "forced_G1_retrained",
            "gate_path_field_nonidentical_required",
            "gate_path_prediction_nonidentical_required",
            "minimum_fixed_uplift_margin",
            "per_fold_performance_vote",
            "per_fold_required"
          ],
          "properties": {
            "Base_rows_must_be_valid": {
              "const": true
            },
            "candidate_true_targets": {
              "const": "strictly_greater_than_endpoint_wise_valid_Base_max"
            },
            "candidate_recovered_anchor_misses": {
              "const": "strictly_greater_than_endpoint_wise_valid_Base_max"
            },
            "candidate_mIoU": {
              "const": "not_below_endpoint_wise_valid_Base_max"
            },
            "candidate_nIoU": {
              "const": "not_below_endpoint_wise_valid_Base_max"
            },
            "versus_v23_true_targets": {
              "const": "strictly_greater"
            },
            "versus_v23_recovered_anchor_misses": {
              "const": "strictly_greater"
            },
            "versus_v23_mIoU": {
              "const": "not_below"
            },
            "versus_v23_nIoU": {
              "const": "not_below"
            },
            "versus_forced_G1_primary_vector": {
              "const": "all_four_not_below_and_at_least_one_strictly_improved"
            },
            "forced_G1_same_terminal_weights": {
              "const": true
            },
            "forced_G1_retrained": {
              "const": false
            },
            "gate_path_field_nonidentical_required": {
              "const": true
            },
            "gate_path_prediction_nonidentical_required": {
              "const": true
            },
            "minimum_fixed_uplift_margin": {
              "type": "null"
            },
            "per_fold_performance_vote": {
              "type": "null"
            },
            "per_fold_required": {
              "const": [
                "finite",
                "source_closure",
                "cache_isolation",
                "retention_equal_1",
                "false_alarm_budgets_pass"
              ]
            }
          }
        }
      }
    },
    "paired_bounded400": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_after_OOF4_PASS",
        "budget",
        "arms",
        "full_D_R_materialization_contract",
        "paired_equalities",
        "independence",
        "pass_vector",
        "evidence_role"
      ],
      "properties": {
        "required_after_OOF4_PASS": {
          "const": true
        },
        "budget": {
          "$ref": "#/$defs/smokeBudget"
        },
        "arms": {
          "const": [
            "PACRE_VC_v23_control",
            "GCR_PACRE_v24"
          ]
        },
        "full_D_R_materialization_contract": {
          "const": {
            "same_semantic_cache_fingerprint_across_arms": true,
            "neutral_payload_fingerprint_recomputed_from_canonical_metadata_and_tensors": true,
            "verifier_issued_materialization_token_required": true
          }
        },
        "paired_equalities": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "independence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "pass_vector": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true
        },
        "evidence_role": {
          "const": "full_D_R_optimization_and_execution_smoke_not_unseen_generalization"
        }
      }
    },
    "Formal800": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerequisites",
        "common_budget",
        "cache_contract",
        "schedule_contract",
        "seed42",
        "seed43"
      ],
      "properties": {
        "common_budget": {
          "$ref": "#/$defs/formalBudget"
        },
        "prerequisites": {
          "const": [
            "dataset_free_PASS",
            "D_R_structural_PASS",
            "D_R_OOF4_PASS",
            "paired_bounded400_PASS"
          ]
        },
        "cache_contract": {
          "const": {
            "same_full_D_R_semantic_cache_fingerprint": true,
            "same_neutral_payload_fingerprint_as_verified_bounded_materialization": true,
            "different_canonical_paths_and_device_inode_pairs": true,
            "hardlink_count_each": 1,
            "FIEMAP_shared_unknown_delalloc_encoded_extents_forbidden": true,
            "fixed_loader_weights_only": true,
            "fixed_loader_mmap": false,
            "actual_concurrent_tensor_storage_intersection_empty": true
          }
        },
        "schedule_contract": {
          "const": {
            "same_policy_and_config_except_seed": true,
            "different_schedule_fingerprints": true,
            "seed42": 42,
            "seed43": 43
          }
        },
        "seed42": {
          "const": {
            "role": "primary",
            "eligible_for_D_V_after_terminal_verification": true,
            "eligible_for_D_T_after_all_future_authorization_checks": true
          }
        },
        "seed43": {
          "const": {
            "role": "training_integrity_only",
            "eligible_for_D_V": false,
            "eligible_for_D_T": false,
            "selection_effect": "none",
            "ensemble_effect": "none",
            "may_replace_seed42": false
          }
        }
      }
    },
    "relative_performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integer_endpoints",
        "mIoU_nIoU",
        "minimum_fixed_uplift_margin",
        "integer_plus_one_is_sufficient",
        "rounding_before_comparison_forbidden"
      ],
      "properties": {
        "integer_endpoints": {
          "const": "strictly_greater_than_exact_endpoint_wise_valid_Base_maxima"
        },
        "mIoU_nIoU": {
          "const": "not_below_exact_endpoint_wise_valid_Base_maxima"
        },
        "minimum_fixed_uplift_margin": {
          "type": "null"
        },
        "integer_plus_one_is_sufficient": {
          "const": true
        },
        "rounding_before_comparison_forbidden": {
          "const": true
        }
      }
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OOF4_authorized",
        "bounded400_authorized",
        "Formal_seed42_authorized",
        "Formal_seed43_authorized",
        "D_V_authorized",
        "D_T_authorized"
      ],
      "properties": {
        "OOF4_authorized": {
          "const": false
        },
        "bounded400_authorized": {
          "const": false
        },
        "Formal_seed42_authorized": {
          "const": false
        },
        "Formal_seed43_authorized": {
          "const": false
        },
        "D_V_authorized": {
          "const": false
        },
        "D_T_authorized": {
          "const": false
        }
      }
    },
    "preregistration_fingerprint": {
      "const": "1ee1e952a8c352c6297e0220e312d210c2a2152d73e1771b912854e062c77f48"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_path",
        "file_sha256"
      ],
      "properties": {
        "repo_path": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "boundedBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochs",
        "steps_per_epoch",
        "updates",
        "training_invocations",
        "from_scratch",
        "resume_allowed",
        "automatic_retry_allowed",
        "checkpoint_policy"
      ],
      "properties": {
        "epochs": {
          "const": 10
        },
        "steps_per_epoch": {
          "const": 40
        },
        "updates": {
          "const": 400
        },
        "training_invocations": {
          "const": 1
        },
        "from_scratch": {
          "const": true
        },
        "resume_allowed": {
          "const": false
        },
        "automatic_retry_allowed": {
          "const": false
        },
        "checkpoint_policy": {
          "const": "final_only"
        }
      }
    },
    "smokeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochs",
        "steps_per_epoch",
        "updates"
      ],
      "properties": {
        "epochs": {
          "const": 10
        },
        "steps_per_epoch": {
          "const": 40
        },
        "updates": {
          "const": 400
        }
      }
    },
    "formalBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochs",
        "steps_per_epoch",
        "updates",
        "training_invocations",
        "from_scratch",
        "resume_allowed",
        "automatic_retry_allowed",
        "checkpoint_policy"
      ],
      "properties": {
        "epochs": {
          "const": 800
        },
        "steps_per_epoch": {
          "const": 40
        },
        "updates": {
          "const": 32000
        },
        "training_invocations": {
          "const": 1
        },
        "from_scratch": {
          "const": true
        },
        "resume_allowed": {
          "const": false
        },
        "automatic_retry_allowed": {
          "const": false
        },
        "checkpoint_policy": {
          "const": "final_only"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "pixel_fa_max",
        "raw_background_fa_max",
        "fp_components_per_megapixel_max",
        "budget_violation"
      ],
      "properties": {
        "retention": {
          "const": 1.0
        },
        "pixel_fa_max": {
          "const": 0.0001
        },
        "raw_background_fa_max": {
          "const": 0.0001
        },
        "fp_components_per_megapixel_max": {
          "const": 100.0
        },
        "budget_violation": {
          "const": false
        }
      }
    }
  }
}
