      "group",
      "within_group_index",
      "match_id",
      "signal_role",
      "channel",
      "row",
      "column"
    ],
    "integer_encoding": "unsigned_base10_without_padding",
    "key_template": "{seed}|{stage}|{group}|{within_group_index}|{match_id}|{signal_role}|{channel}|{row}|{column}",
    "digest": "SHA256(serialized_key_utf8)"
