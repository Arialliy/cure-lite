  },
  "factual_tokens": {
    "stage": "factual",
    "group": "branch token factual_miss or factual_no_miss",
    "within_group_index": "state_index",
    "match_id_derivation_template": "SHA256(UTF8(nlcc-v12|{profile_id}|{design_seed}|factual|{branch}|{state_index_3digit_zero_padded}))",
    "signal_role": "branch token factual_miss or factual_no_miss"
  },
  "value_mapping": {
    "magnitude": "(32+(uint16_big_endian(digest[0:2])%97))/64",
    "sign": "+1_if_digest_byte_2_low_bit_is_1_else_-1",
    "magnitude_bounds_inclusive": [
      0.5,
      2.0
