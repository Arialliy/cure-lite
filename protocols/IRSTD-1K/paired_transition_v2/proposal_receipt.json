  },
  "pair_truth_contract": {
    "occupancy_relation": "O_minus_subset_O_plus",
    "completion_plus": "R_plus=R_G_V(O_plus)",
    "completion_minus": "R_minus=R_G_V(O_minus)",
    "completion_monotonicity": "R_plus_subset_R_minus",
    "label_increment": "D=R_minus_setminus_R_plus",
    "writable_background_plus": "B_plus=V_intersect_not_O_plus_intersect_not_union_G",
    "baseline_valid_domain": "M_plus=R_plus_union_B_plus",
    "shared_feature": "one_exact_detached_frozen_feature_is_reused_for_both_endpoints",
    "optimizer_pair_kind": "clean_positive"
  },
  "objective": {
    "score_definition": "q_plus=sigmoid(z_plus);q_minus=sigmoid(z_minus)",
    "baseline_coordinate": "ell_base=CURELiteLoss(z_plus,indicator_R_plus,M_plus)",
    "transition_coordinate": "ell_delta=mean_pair[0.5*mean_D(((q_minus-q_plus-1)/2)^2)+0.5*mean_(V_without_D)((q_minus-q_plus)^2)]",
    "per_pair": "ell_APTO=0.5*ell_base+0.5*ell_delta",
    "pair_batch_reduction": "arithmetic_mean_over_pairs",
    "total": "L_v2=L_factual_miss+L_factual_no_miss+L_APTO",
    "apto_internal_weights": {
      "baseline": 0.5,
      "transition": 0.5
    },
    "total_branch_weights": {
      "factual_miss": 1.0,
      "factual_no_miss": 1.0,
      "apto": 1.0
    },
    "weights_are_searchable": false,
    "both_endpoints_attached": true,
    "difference_before_hard_mask": true,
    "legal_minus_endpoint_independent_absolute_loss_in_proposed": false,
    "mixed_endpoint_derivative_required": true
  },
